{
  "name": "immocloud-mcp",
  "version": "1.0.1",
  "description": "Hybrid MCP server for Immocloud's private REST API with email/password login, bank tools, and OAuth-ready stubs",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "immocloud-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test 'dist/**/*.test.js' 'dist/*.test.js'",
    "health-check": "npm run build && node --env-file=.env dist/health-check.js"
  },
  "keywords": [
    "immocloud",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Jan-Hendrik Huehne",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhuehne/mcp-immocloud.git"
  },
  "bugs": {
    "url": "https://github.com/janhuehne/mcp-immocloud/issues"
  },
  "homepage": "https://github.com/janhuehne/mcp-immocloud#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/keyring": "^2.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
