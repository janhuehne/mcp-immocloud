# Private REST API mode (current implementation)
IMMOCLOUD_AUTH_MODE=token
# Security-pinned; other schemes, hosts, ports, and paths are rejected.
IMMOCLOUD_BASE_URL=https://app.immocloud.de/api
IMMOCLOUD_WHITELABEL=IMMOCLOUD

# Preferred: email/password login (no token paste). Cursor loads this file via
# `node --env-file=...`. Login tools + auto-bootstrap on MCP start.
IMMOCLOUD_ENABLE_LOGIN_TOOLS=true
IMMOCLOUD_EMAIL=you@example.com
IMMOCLOUD_PASSWORD=
# Trusted device from a previous Immocloud verify (skips email code when valid).
IMMOCLOUD_DEVICE_ID=

# Optional: paste a Bearer token instead of password login.
# IMMOCLOUD_AUTH_TOKEN=Bearer replace-with-your-token

# Session storage: auto (default) prefers OS keychain and falls back to file;
# keychain requires Keychain/Credential Manager/Secret Service; file stores the
# Bearer token in the session file (mode 0600).
IMMOCLOUD_SESSION_BACKEND=auto
# Optional override for the session metadata/file path
# (default: .immocloud/session.json).
# IMMOCLOUD_SESSION_PATH=

# Global write kill switch. true overrides both write-tool flags below.
IMMOCLOUD_READ_ONLY=false

# Write tools are off by default. Each enabled write also requires confirm=true,
# which is a technical guardrail and is not proof of human approval.
IMMOCLOUD_ENABLE_BANKING_WRITE_TOOLS=false
IMMOCLOUD_ENABLE_PROPERTY_WRITE_TOOLS=false

IMMOCLOUD_REQUEST_TIMEOUT_MS=30000

# Reserved for the future official Immocloud MCP OAuth integration.
# IMMOCLOUD_AUTH_MODE=oauth
IMMOCLOUD_OAUTH_CLIENT_ID=
IMMOCLOUD_OAUTH_REDIRECT_URI=
IMMOCLOUD_OAUTH_SCOPES=

# Restart the MCP server after changing this file.
